+// --- Test pattern support ---
+
+bool frame_boot_config(void) {
+    // A mode change arrives as a watchdog reboot with the wanted state in the scratch
+    // registers. A power cycle clears them, so the module always powers up mirroring.
+    uint32_t scratch = watchdog_hw->scratch[0];
+    watchdog_hw->scratch[0] = 0;
+    memset(&tpg_boot_state, 0, sizeof(tpg_boot_state));
+    tpg_boot_state.overlay = 1;
+    strcpy(tpg_boot_state.label, "FLIPPER TPG");
+    if((scratch >> 16) != SCRATCH_MAGIC) return false;
+    uint8_t m = scratch & 0xff, p = (scratch >> 8) & 0x7f;
+    if(m >= FRAME_MODE_COUNT || p >= TpgPatternCount) return false;
+    mode_index = m;
+    mode = &frame_modes[m];
+    tpg_boot_state.mode = m;
+    tpg_boot_state.pattern = p;
+    tpg_boot_state.overlay = (scratch >> 15) & 1;
+    memcpy(tpg_boot_state.label, &watchdog_hw->scratch[1], TPG_LABEL_MAX);
+    tpg_boot_state.label[TPG_LABEL_MAX] = 0;
+    for(char* c = tpg_boot_state.label; *c; c++)
+        if(*c < 32 || *c > 126) *c = '?';
+    tpg_active = true;
+    return true;
+}
+
+uint8_t frame_get_mode(void) {
+    return mode_index;
+}
+
+bool frame_mode_valid(uint8_t m) {
+    return m < FRAME_MODE_COUNT;
+}
+
+void frame_tpg_set_active(bool active) {
+    tpg_active = active;
+}
+
+void frame_reboot(const TpgState* state) {
+    if(state) {
+        char label[TPG_LABEL_MAX] = {0};
+        strncpy(label, state->label, TPG_LABEL_MAX);
+        memcpy(&watchdog_hw->scratch[1], label, TPG_LABEL_MAX);
+        watchdog_hw->scratch[0] = (SCRATCH_MAGIC << 16) | ((uint32_t)(state->overlay ? 1 : 0) << 15) |
+                                  ((uint32_t)state->pattern << 8) | state->mode;
+    } else {
+        watchdog_hw->scratch[0] = 0;
+    }
+    watchdog_reboot(0, 0, 10);
+    while(1) tight_loop_contents();
+}
