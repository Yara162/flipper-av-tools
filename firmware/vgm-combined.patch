+
+// Called from the RX interrupt for every byte received at the initial baud rate
+static void tpg_detect_byte(uint8_t ch) {
+    static char line[TPG_LINE_MAX];
+    static size_t len = 0;
+    if(ch == '\n' || ch == '\r') {
+        line[len] = 0;
+        if(len) tpg_parse_line(line);
+        len = 0;
+    } else if(ch < 32 || ch > 126 || len >= TPG_LINE_MAX - 1) {
