+// Parse "P,<mode>,<chunk>,<hold>": the pixel-fixer noise pattern
+static void tpg_parse_pixel_line(const char* line) {
+    unsigned v[3] = {0, 0, 0};
+    const char* p = line + 2;
+    for(int i = 0; i < 3; i++) {
+        if(*p < '0' || *p > '9') return;
+        while(*p >= '0' && *p <= '9') v[i] = v[i] * 10 + (unsigned)(*p++ - '0');
+        if(i < 2 && *p++ != ',') return;
+    }
+    if(*p != 0) return;
+    if(v[0] > 255 || !frame_mode_valid((uint8_t)v[0])) return;
+    if(v[1] < 2 || v[1] > 128 || v[2] < 1 || v[2] > 120) return;
+    memset(&tpg_rx_state, 0, sizeof(tpg_rx_state));
+    tpg_rx_state.mode = (uint8_t)v[0];
+    tpg_rx_state.pattern = TpgPixelFix;
+    tpg_rx_state.chunk = (uint8_t)v[1];
+    tpg_rx_state.hold = (uint8_t)v[2];
+    tpg_rx_seq++;
+    tpg_rx_time = xTaskGetTickCountFromISR();
+}
+
+static void tpg_parse_line(const char* line) {
+    if(line[0] == 'P' && line[1] == ',') {
+        tpg_parse_pixel_line(line);
+        return;
+    }
+    if(line[0] != 'S' || line[1] != ',') return;
+    unsigned v[3] = {0, 0, 0};
+    const char* p = line + 2;
+    for(int i = 0; i < 3; i++) {
+        if(*p < '0' || *p > '9') return;
+        while(*p >= '0' && *p <= '9') v[i] = v[i] * 10 + (unsigned)(*p++ - '0');
+        if(*p++ != ',') return;
+    }
+    if(v[0] > 255 || !frame_mode_valid((uint8_t)v[0]) || v[1] >= TpgPixelFix) return;
+    memset(&tpg_rx_state, 0, sizeof(tpg_rx_state));
+    tpg_rx_state.mode = (uint8_t)v[0];
+    tpg_rx_state.pattern = (uint8_t)v[1];
+    tpg_rx_state.overlay = v[2] ? 1 : 0;
+    strncpy(tpg_rx_state.label, p, TPG_LABEL_MAX);
+    tpg_rx_seq++;
+    tpg_rx_time = xTaskGetTickCountFromISR();
